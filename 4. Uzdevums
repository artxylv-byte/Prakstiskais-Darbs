
[CmdletBinding(SupportsShouldProcess)]
param()
$visiServisi = Get-Service
$atrastie = @($visiServisi | Where-Object -FilterScript { $_.StartType -eq "Automatic" -and $_.Status -eq "Stopped" })
if ($atrastie.Count -eq 0) {
    Write-Output "Atrasto servisu skaits: 0"
}
else {
    Write-Output "Atrasto servisu skaits: $($atrastie.Count)"
    foreach ($serviss in $atrastie) {
        Write-Output "Palaiž servisu: $($serviss.Name)"
        Start-Service -Name $serviss.Name
    }
}
