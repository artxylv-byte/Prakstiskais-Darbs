
$robezaGB = 20
$diski = Get-CimInstance -ClassName Win32_LogicalDisk -Filter "DriveType = 3"
foreach ($disks in $diski) {
    $kopejais = [math]::Round($disks.Size / 1GB, 2)
    $brivais = [math]::Round($disks.FreeSpace / 1GB, 2)
    Write-Output "Disks: $($disks.DeviceID)  Kopā: $kopejais GB  Brīvi: $brivais GB"
    if ($brivais -lt $robezaGB) {
        Write-Output "BRĪDINĀJUMS: diskā $($disks.DeviceID) ir mazāk par $robezaGB GB brīvas vietas"
    }
}
