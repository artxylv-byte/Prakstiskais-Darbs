$visiProcesi = Get-Process
$lielakie = $visiProcesi | Sort-Object -Property WorkingSet64 -Descending
$desmit = $lielakie | Select-Object -First 10
$augosi = $desmit | Sort-Object -Property WorkingSet64
foreach ($process in $augosi) {
    $megabaiti = [math]::Round($process.WorkingSet64 / 1MB, 1)
    Write-Output "Nosaukums: $($process.ProcessName)  Id: $($process.Id)  Atmiņa: $megabaiti MB"
}
